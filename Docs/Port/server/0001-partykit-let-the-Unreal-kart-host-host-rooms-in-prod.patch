 partykit/src/config.ts             | 14 ++++++++++++++
 partykit/src/server.config.test.ts | 26 +++++++++++++++++++++++++-
 partykit/src/server.ts             |  4 +++-
 4 files changed, 66 insertions(+), 2 deletions(-)

