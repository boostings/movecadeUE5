@@ -1,5 +1,5 @@
 import { CloseCode, ErrorCode, PROTOCOL_VERSION, isRecord, isString, type EntitlementJwk, type JsonObject, type JsonValue } from '@v2/protocol';
-import { resolveDeploymentMode, validateDeploymentConfig, type DeploymentConfigReport } from './config.js';
+import { NATIVE_HOST_ORIGINS, resolveDeploymentMode, validateDeploymentConfig, type DeploymentConfigReport } from './config.js';
 import { RoomEngine } from './engine.js';
 import { nodeCrypto } from './nodeCrypto.js';
 import { SystemScheduler, type ConnectionContext, type RoomIo, type RoomStorage } from './ports.js';
@@ -144,6 +144,8 @@ export default class MovecadeV2Server {
     // a Vercel preview origin on staging, a local build under test in dev.
     const allowedOrigins = [
       ...(isProduction ? DEFAULT_ALLOWED_ORIGINS : [...DEFAULT_ALLOWED_ORIGINS, ...DEV_ALLOWED_ORIGINS]),
+      // The Unreal kart host, wherever production runs (see NATIVE_HOST_ORIGINS).
+      ...(isProduction ? NATIVE_HOST_ORIGINS : []),
       ...parseOrigins(readEnv('EXTRA_ALLOWED_ORIGINS', roomEnv)),
     ];
     const scoreSigningSecret = readEnv('SCORE_SIGNING_SECRET', roomEnv);
