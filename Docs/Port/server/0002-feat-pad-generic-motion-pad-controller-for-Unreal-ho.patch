+import { afterEach, describe, expect, it, vi } from 'vitest';
+import { act, fireEvent, render, screen } from '@testing-library/react';
+import { ScreenOrientation, type JsonValue } from '@v2/protocol';
+import { MotionPadController, leanFrom } from './MotionPadController';
+import { watchPadPrompts } from './padPrompts';
+import { findGame, GAMES } from '../registry';
+import { createFakeSession, makePlayer, makeRoom, noSampleFeed } from '../../../test/fakeSession';
+import type { ControllerMotionSample } from '../types';
+
+function sample(overrides: Partial<ControllerMotionSample> = {}): ControllerMotionSample {
+  return {
+    alpha: 0,
+    beta: 0,
+    gamma: 0,
+    gyro: { x: 0, y: 0, z: 0 },
+    accel: { x: 0, y: 0, z: 0 },
+    gravity: { x: 0, y: -9.8, z: 0 },
+    screenOrientation: ScreenOrientation.Portrait,
+    dtMs: 10,
+    ...overrides,
+  };
+}
+
+type Session = ReturnType<typeof createFakeSession>;
+
+/** Deliver a frame as the server relays it (host frames have no fromPlayerId). */
+function deliver(session: Session, event: string, data: JsonValue, fromPlayerId: string | null = null) {
+  // SAFETY: the fake SessionClient exposes its private listener set only in
+  // this test helper; production code never reaches through that boundary.
+  const opaqueClient: unknown = session.client;
+  // SAFETY: the opaque value is the real fake SessionClient described above.
+  const testClient = opaqueClient as {
+    eventListeners: Set<(event: string, data: JsonValue | undefined, fromPlayerId: string | null) => void>;
+  };
+  act(() => testClient.eventListeners.forEach((listener) => listener(event, data, fromPlayerId)));
+}
+
+function play(gameId = 'sumo', { isActive = true, matchNumber = 1 } = {}) {
+  const session = createFakeSession('controller');
+  const me = makePlayer({ id: 'p1', score: 0, screen: 'active' });
+  const room = makeRoom({ gameId, players: [me], game: { status: 'in-progress', matchNumber } });
+  session.setState({ room });
+  const props = { client: session.client, room, me, isActive, sample: sample(), subscribeSamples: noSampleFeed };
+  const view = render(session.wrap(<MotionPadController {...props} />));
+  return { session, view, props };
+}
+
+function padEvents(session: Session) {
+  return session.sent.filter((message) => message.t === 'game-event');
+}
