+import { MOTION_PAD_GAMES, type MotionPadGame } from '@v2/protocol';
+import type { GamePlugin } from '../types';
+
+/**
+ * Plugins for the motion pad games (`protocol/src/motionPad.ts`).
+ *
+ * These games are hosted by another program (the Movecade Kart PC game), so
+ * they are deliberately NOT in `GAMES`: the web picker, the homepage and the
+ * catalogue conformance test only list games this app can host. `findGame`
+ * falls back to this list so a phone that joins such a room gets the motion
+ * pad, the right calibration grip and the right stream rate.
+ */
+export function motionPadPlugin(game: MotionPadGame): GamePlugin {
+  return {
+    manifest: {
+      id: game.id,
+      name: game.name,
+      tagline: game.tagline,
+      tier: game.tier,
+      emoji: '🎮',
+      minPlayers: game.players.min,
+      maxPlayers: game.players.max,
+      simultaneous: game.playMode === 'simultaneous',
+      tone: 'accent',
+      scoreLabel: game.scoreLabel,
+      controls: { verb: game.controls.verb, hint: game.controls.hint },
+      sendHz: game.sendHz,
+    },
+    loadCanvas: async () => (await import('./MotionPadCanvas')).MotionPadCanvas,
+    loadController: async () => (await import('./MotionPadController')).MotionPadController,
+  };
+}
+
+export const MOTION_PAD_PLUGINS: readonly GamePlugin[] = MOTION_PAD_GAMES.map(motionPadPlugin);
