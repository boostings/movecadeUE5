+    sendMessage(kit.engine, 'p2', { t: 'game-event', event: 'pad:prompt', data: { ...prompt, title: 'Give up' } });
+    expect(errorCodes(kit, 'p2')).toContain(ErrorCode.HOST_ONLY);
+    expect(kit.framesFor('p1', 'game-event').filter((frame) => frame.t === 'game-event' && frame.event === 'pad:prompt')).toHaveLength(1);
