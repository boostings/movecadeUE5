+    sendMessage(kit.engine, 'host', { t: 'game-event', event: 'pad:prompt', data: prompt });
+    expect(kit.framesFor('p1', 'game-event')).toContainEqual(
+      expect.objectContaining({ event: 'pad:prompt', data: prompt, fromPlayerId: null })
