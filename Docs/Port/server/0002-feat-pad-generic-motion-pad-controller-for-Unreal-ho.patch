+  MOTION_PAD_GAME_IDS,
+  PAD_PROMPT_EVENT,
+  PREMIUM_GAME_IDS,
+  SIMULTANEOUS_GAME_IDS,
+  findMotionPadGame,
+  isFreeGame,
+  isMotionGame,
+  isMotionPadGame,
+  isSimultaneousGame,
+  motionGripInstructions,
+  normalizeGameId,
+  readMotionPadPrompt,
+  validMotionCalibration,
+} from './index.js';
+
+describe('motion pad game list', () => {
+  it('lists the Unreal-hosted motion games once', () => {
+    expect(MOTION_PAD_GAME_IDS).toEqual(['sumo', 'derby', 'fishing']);
+    expect(new Set(MOTION_PAD_GAME_IDS).size).toBe(MOTION_PAD_GAME_IDS.length);
+  });
+
+  it('makes every pad id a known room game', () => {
+    for (const id of MOTION_PAD_GAME_IDS) {
+      expect(normalizeGameId(id)).toBe(id);
+      expect(normalizeGameId(` ${id.toUpperCase()} `)).toBe(id);
+      expect(isMotionGame(id)).toBe(true);
+      expect(isMotionPadGame(id)).toBe(true);
+      expect(GAME_MAX_SCORE[id]).toBe(999_999);
+      expect(GAME_MIN_SIGNED_SCORE[id]).toBe(0);
+    }
+    expect(isMotionPadGame('bowling')).toBe(false);
+    expect(normalizeGameId('curling')).toBeNull();
+  });
+
+  it('keeps them premium (bowling stays the only free game) and out of the web launch lineup', () => {
+    expect(FREE_GAME_IDS).toEqual(['bowling']);
+    for (const id of MOTION_PAD_GAME_IDS) {
+      expect(isFreeGame(id)).toBe(false);
+      expect(PREMIUM_GAME_IDS).toContain(id);
+      expect(LAUNCH_GAME_IDS).not.toContain(id);
+    }
+  });
+
+  it('runs sumo and fishing simultaneously and derby turn by turn', () => {
+    expect(isSimultaneousGame('sumo')).toBe(true);
+    expect(isSimultaneousGame('fishing')).toBe(true);
+    expect(isSimultaneousGame('derby')).toBe(false);
+    expect(SIMULTANEOUS_GAME_IDS).toEqual(expect.arrayContaining(['sumo', 'fishing']));
+    expect(SIMULTANEOUS_GAME_IDS).not.toContain('derby');
+  });
+
+  it('accepts a phone neutral captured for a pad game', () => {
+    expect(validMotionCalibration({
+      version: 1, id: 'c1', sessionId: 's1', gameId: 'fishing', hand: 'left',
+      quaternion: { x: 0, y: 0, z: 0, w: 1 }, gravity: { x: 0, y: -9.8, z: 0 }, accelBias: { x: 0, y: 0, z: 0 },
+      noise: 0.01, samples: 40,
+    })).toBe(true);
+  });
+
+  it('gives each pad game its own calibration grip', () => {
+    for (const game of MOTION_PAD_GAMES) {
+      expect(motionGripInstructions(game.id, 'right')).toBe(game.grip);
+      expect(game.grip.steps.length).toBeGreaterThan(0);
+    }
+    expect(findMotionPadGame('nope')).toBeNull();
+  });
+
+  it('reserves pad:prompt for the host', () => {
+    expect(HOST_ONLY_GAME_EVENTS.has(PAD_PROMPT_EVENT)).toBe(true);
+    expect(HOST_ONLY_GAME_EVENTS.has('pad:press')).toBe(false);
+    expect(HOST_ONLY_GAME_EVENTS.has('pad:release')).toBe(false);
+  });
+});
+
+describe('readMotionPadPrompt', () => {
+  it('reads the full contract', () => {
+    expect(readMotionPadPrompt({
+      playerId: 'p1', title: 'Your bat', subtitle: 'Swing when it is close', a: '', b: 'BUNT', accent: '#3fa7ff', mode: 'swing',
+    })).toEqual({ playerId: 'p1', title: 'Your bat', subtitle: 'Swing when it is close', a: '', b: 'BUNT', accent: '#3fa7ff', mode: 'swing' });
+  });
+
+  it('drops what it does not understand instead of showing it', () => {
+    expect(readMotionPadPrompt({ playerId: 'p1', title: 7, a: { x: 1 }, accent: 'red', mode: 'dance' })).toEqual({
+      playerId: 'p1', title: '', subtitle: '', a: '', b: '', accent: null, mode: null,
+    });
+  });
+
+  it('bounds the text', () => {
+    const prompt = readMotionPadPrompt({ playerId: 'p1', title: 'x'.repeat(200), subtitle: 'y'.repeat(400), a: 'z'.repeat(40) });
+    expect(prompt?.title).toHaveLength(80);
+    expect(prompt?.subtitle).toHaveLength(160);
+    expect(prompt?.a).toHaveLength(16);
+  });
+
+  it('refuses a prompt for nobody', () => {
+    expect(readMotionPadPrompt({ title: 'Hi' })).toBeNull();
+    expect(readMotionPadPrompt({ playerId: '' })).toBeNull();
+    expect(readMotionPadPrompt('p1')).toBeNull();
+    expect(readMotionPadPrompt(null)).toBeNull();
+  });
+});
diff --git a/protocol/src/motionPad.ts b/protocol/src/motionPad.ts
new file mode 100644
index 00000000..e5ed8dbd
--- /dev/null
+++ b/protocol/src/motionPad.ts
@@ -0,0 +1,179 @@
+import { isBoundedString, isRecord, isString } from './validate.js';
+
+/**
+ * The motion pad: one generic phone controller for games hosted somewhere
+ * other than this web app (the Movecade Kart PC game hosts these rooms).
+ *
+ * Such a game has no web canvas and no bespoke phone screen. The phone shows
+ * whatever the host prompts it with (`pad:prompt`), one or two big buttons
+ * (`pad:press` / `pad:release`), and streams the same calibrated sensor frames
+ * every motion game streams while the match is in progress.
+ *
+ * `MOTION_PAD_GAMES` is the one list. Adding an entry here makes the room
+ * server accept the id (configure-room, the host handshake, scores, signing),
+ * puts it in the free / premium / simultaneous lists, lets a phone calibrate
+ * for it, and maps it to the motion pad on the phone. Nothing else changes:
+ * the web catalog (`game-manifest/catalog.json`) is for games this app can
+ * host itself, so these ids stay out of its picker, SEO and leaderboards.
+ */
+
+/** Which hold-the-phone hint the pad animates. */
+export const MOTION_PAD_MODES = ['tilt', 'swing', 'aim', 'flick'] as const;
+export type MotionPadMode = (typeof MOTION_PAD_MODES)[number];
+
+export const MOTION_PAD_BUTTONS = ['a', 'b'] as const;
+export type MotionPadButton = (typeof MOTION_PAD_BUTTONS)[number];
+
+/** Phone to host: a pad button went down / came up. Data `{ button }`. */
+export const PAD_PRESS_EVENT = 'pad:press';
+export const PAD_RELEASE_EVENT = 'pad:release';
+/** Host to phone (host-only): what this player should do now. See `MotionPadPrompt`. */
+export const PAD_PROMPT_EVENT = 'pad:prompt';
+
+export interface MotionPadGame {
+  id: string;
+  name: string;
+  tagline: string;
+  /**
+   * Same meaning as the catalog's tier. Premium only gates anything when the
+   * deployment runs with `ENABLE_MONETIZATION=true`; local dev and today's
+   * production leave it off, so every game here is playable there.
+   */
+  tier: 'free' | 'premium';
+  /** Turn-based games get `activePlayerId` from the host's advance-turn; the others never have a turn. */
+  playMode: 'simultaneous' | 'turn-based';
+  players: { min: number; max: number };
+  scoreLabel: string;
+  scoring: { mode: 'highest' | 'lowest'; min: number; max: number; format: 'score' };
+  /** The hint shown before the host's first prompt arrives. */
+  mode: MotionPadMode;
+  /** Sensor frames per second while active. Samurai streams 100; swings want the same. */
+  sendHz: number;
+  controls: { verb: string; hint: string };
+  /** Button labels before the first prompt; an empty `b` shows one button. */
+  buttons: { a: string; b: string };
+  accent: string;
+  /** The calibrate screen's grip: how to hold the phone while the neutral is captured. */
+  grip: { title: string; steps: readonly string[] };
+}
+
+export const MOTION_PAD_GAMES = [
+  {
+    id: 'sumo',
+    name: 'Sumo Smash',
+    tagline: 'Tilt to roll. Dash to shove them out.',
+    tier: 'premium',
+    playMode: 'simultaneous',
+    players: { min: 1, max: 4 },
+    scoreLabel: 'Points',
+    scoring: { mode: 'highest', min: 0, max: 999_999, format: 'score' },
+    mode: 'tilt',
+    sendHz: 60,
+    controls: { verb: 'Tilt', hint: 'Hold your phone flat and tilt it to roll. Tap DASH to shove.' },
+    buttons: { a: 'DASH', b: '' },
+    accent: '#ff6b4a',
+    grip: {
+      title: 'Hold it flat like a tray',
+      steps: ['Hold the phone flat in front of you, screen up.', 'Tilt it the way you want to roll.', 'Tap DASH with your thumb to shove.'],
+    },
+  },
+  {
+    id: 'derby',
+    name: 'Home Run Derby',
+    tagline: 'Swing your phone like a bat. Send it out of the park.',
+    tier: 'premium',
+    // One batter at a time: the host names the batter with advance-turn, the
+    // way bowling names the bowler, and everyone else waits between turns.
+    playMode: 'turn-based',
+    players: { min: 1, max: 4 },
+    scoreLabel: 'Runs',
+    scoring: { mode: 'highest', min: 0, max: 999_999, format: 'score' },
+    mode: 'swing',
+    sendHz: 100,
+    controls: { verb: 'Swing', hint: 'Hold your phone like a bat and swing when the pitch arrives.' },
+    buttons: { a: '', b: '' },
+    accent: '#3fa7ff',
+    grip: {
+      title: 'Hold it like a bat',
+      steps: ['Grip the bottom of the phone in both hands, screen facing you.', 'Take your stance with the phone over your back shoulder.', 'Swing through when the pitch arrives. Keep a tight grip.'],
+    },
+  },
+  {
+    id: 'fishing',
+    name: 'Gone Fishing',
+    tagline: 'Flick to cast. Jerk to hook. Roll your wrist to reel.',
+    tier: 'premium',
+    playMode: 'simultaneous',
+    players: { min: 1, max: 4 },
+    scoreLabel: 'Points',
+    scoring: { mode: 'highest', min: 0, max: 999_999, format: 'score' },
+    mode: 'flick',
+    sendHz: 100,
+    controls: { verb: 'Flick', hint: 'Flick your phone forward to cast, jerk it up to hook, roll your wrist to reel.' },
+    buttons: { a: 'REEL', b: '' },
+    accent: '#2bc4a8',
+    grip: {
+      title: 'Hold it like a rod',
+      steps: ['Hold the phone upright in front of you, like the handle of a rod.', 'Flick it forward to cast, jerk it up when a fish bites.', 'Roll your wrist in circles to reel in.'],
+    },
+  },
+] as const satisfies readonly MotionPadGame[];
+
+export type MotionPadGameId = (typeof MOTION_PAD_GAMES)[number]['id'];
+
+export const MOTION_PAD_GAME_IDS: readonly MotionPadGameId[] = MOTION_PAD_GAMES.map((game) => game.id);
+
+export function isMotionPadGame<T>(value: T): value is T & MotionPadGameId {
+  return MOTION_PAD_GAME_IDS.some((id) => id === value);
+}
+
+export function findMotionPadGame(id: string | null | undefined): MotionPadGame | null {
+  return MOTION_PAD_GAMES.find((game) => game.id === id) ?? null;
+}
+
+export function isMotionPadMode<T>(value: T): value is T & MotionPadMode {
+  return MOTION_PAD_MODES.some((mode) => mode === value);
+}
+
+export function isMotionPadButton<T>(value: T): value is T & MotionPadButton {
+  return MOTION_PAD_BUTTONS.some((button) => button === value);
+}
+
+/** `pad:prompt` data. Empty `a` / `b` hides that button. */
+export interface MotionPadPrompt {
+  playerId: string;
+  title: string;
+  subtitle: string;
+  a: string;
+  b: string;
+  /** `#rrggbb`, or null when the host sent none (the game's accent is used). */
+  accent: string | null;
+  mode: MotionPadMode | null;
+}
+
+const ACCENT_RE = /^#[0-9a-fA-F]{6}$/;
+const PROMPT_TITLE_MAX = 80;
+const PROMPT_SUBTITLE_MAX = 160;
+const PROMPT_LABEL_MAX = 16;
+
+function text<T>(value: T, max: number): string {
+  return isString(value) ? value.slice(0, max) : '';
+}
+
+/**
+ * Reads `pad:prompt` data defensively: it is relayed verbatim from the host,
+ * so anything the phone does not understand is dropped rather than shown.
+ * Returns null without a player id (a prompt for nobody).
+ */
+export function readMotionPadPrompt<T>(data: T): MotionPadPrompt | null {
+  if (!isRecord(data) || !isBoundedString(data.playerId, 64) || data.playerId.length === 0) return null;
+  return {
+    playerId: data.playerId,
+    title: text(data.title, PROMPT_TITLE_MAX),
+    subtitle: text(data.subtitle, PROMPT_SUBTITLE_MAX),
+    a: text(data.a, PROMPT_LABEL_MAX),
+    b: text(data.b, PROMPT_LABEL_MAX),
+    accent: isString(data.accent) && ACCENT_RE.test(data.accent) ? data.accent : null,
+    mode: isMotionPadMode(data.mode) ? data.mode : null,
+  };
+}
