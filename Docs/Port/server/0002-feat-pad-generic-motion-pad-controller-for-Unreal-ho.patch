+import { findMotionPadGame } from '@v2/protocol';
+import type { GameCanvasProps } from '../types';
+
+/**
+ * A motion pad game has no web scene: another program is the TV. A browser
+ * that somehow hosts one (an old link, a hand-typed URL) says so instead of
+ * rendering nothing.
+ */
+export function MotionPadCanvas({ room }: GameCanvasProps) {
+  const game = findMotionPadGame(room.gameId);
+  return (
+    <div className="grid h-full w-full place-items-center p-8 text-center" data-testid="motion-pad-canvas">
+      <div>
+        <p className="font-display text-4xl text-ink">{game?.name ?? 'This game'}</p>
+        <p className="mt-3 text-lg text-ink-muted">This game is played on the Movecade Kart PC game. Phones still join here.</p>
+      </div>
+    </div>
+  );
+}
