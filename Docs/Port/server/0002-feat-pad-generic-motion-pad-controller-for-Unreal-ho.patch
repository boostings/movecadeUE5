--- /dev/null
+++ b/partykit/src/engine.motionPad.test.ts
@@ -0,0 +1,153 @@
+import { describe, expect, it } from 'vitest';
+import { ErrorCode, MOTION_PAD_GAMES, MOTION_PAD_GAME_IDS, type JsonObject } from '@v2/protocol';
+import { connect, createTestEngine, flushMicrotasks, sendMessage, type TestEngine } from './testKit.js';
+
+/**
+ * The motion pad games (protocol/src/motionPad.ts) are hosted by the Unreal
+ * game, with the generic motion pad on the phones. The room must take them
+ * exactly like a catalogue game: configure, calibrate, start, turns, scores,
+ * and the pad's events.
+ */
+
+/** A phone's motion neutral as it goes on the wire; the server's validator is what is under test. */
+function motionCalibration(gameId: string): JsonObject {
+  return {
+    version: 1,
+    id: `cal-${gameId}`,
+    sessionId: 'motion-1',
+    gameId,
+    hand: 'right',
+    quaternion: { x: 0, y: 0, z: 0, w: 1 },
+    gravity: { x: 0, y: -9.8, z: 0 },
+    accelBias: { x: 0, y: 0, z: 0 },
+    noise: 0.01,
+    samples: 40,
+  };
+}
+
+async function readyRoom(kit: TestEngine, gameId: string, players = ['p1']): Promise<void> {
+  connect(kit.engine, 'host', 'host');
+  for (const id of players) {
+    connect(kit.engine, id, 'controller');
+    sendMessage(kit.engine, id, { t: 'join-player', name: id.toUpperCase() });
+  }
+  sendMessage(kit.engine, 'host', { t: 'configure-room', gameId });
+  await kit.engine.whenCommandsIdle();
+  for (const id of players) {
+    sendMessage(kit.engine, id, {
+      t: 'calibrate', alpha: 0, beta: 0, gamma: 0, screenOrientation: 0, motion: motionCalibration(gameId),
+    });
+    sendMessage(kit.engine, id, { t: 'set-ready', ready: true });
+  }
+  await flushMicrotasks();
+}
+
+function errorCodes(kit: TestEngine, sessionId: string): string[] {
+  return kit.framesFor(sessionId, 'error').map((frame) => (frame.t === 'error' ? frame.code : ''));
+}
+
+describe('motion pad games in a room', () => {
+  it.each(MOTION_PAD_GAME_IDS)('configures, calibrates and starts %s', async (gameId) => {
+    const kit = createTestEngine();
+    await kit.engine.start();
+    await readyRoom(kit, gameId, ['p1', 'p2']);
+    expect(kit.engine.snapshotState().gameId).toBe(gameId);
+    // The motion neutral was kept, so the phone is on the ready screen, not calibrate.
