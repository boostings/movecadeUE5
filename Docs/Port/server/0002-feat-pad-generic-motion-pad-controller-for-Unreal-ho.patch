diff --git a/protocol/src/scoring.ts b/protocol/src/scoring.ts
index 2eaa9448..a71c9dec 100644
--- a/protocol/src/scoring.ts
+++ b/protocol/src/scoring.ts
@@ -1,11 +1,25 @@
 import { MAX_SCORE, SCORE_SIGNATURE_VERSION } from './constants.js';
 import { isString, sanitizePlayerName } from './validate.js';
+import { MOTION_PAD_GAMES, isMotionPadGame } from './motionPad.js';
 // Keep the canonical authored catalog import valid in both bundlers and the
 // native Node ESM loader used by Playwright's test discovery. Without the JSON
