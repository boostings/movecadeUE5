+import { describe, expect, it } from 'vitest';
+import {
+  FREE_GAME_IDS,
+  GAME_MAX_SCORE,
+  GAME_MIN_SIGNED_SCORE,
+  HOST_ONLY_GAME_EVENTS,
+  LAUNCH_GAME_IDS,
