@@ -0,0 +1,231 @@
+import { useCallback, useEffect, useRef, useState, useSyncExternalStore } from 'react';
+import {
+  PAD_PRESS_EVENT,
+  PAD_RELEASE_EVENT,
+  findMotionPadGame,
+  type MotionPadButton,
+  type MotionPadMode,
+  type MotionPadPrompt,
+} from '@v2/protocol';
+import { HAPTIC, buzz } from '../../hooks/haptics';
+import { Screen } from '../../ui';
+import { cssVarStyle } from '../../lib/cssVars';
+import type { ControllerSurfaceProps } from '../types';
+import { currentPadPrompt, subscribePadPrompts } from './padPrompts';
+import './motion-pad.css';
+
+/**
+ * The motion pad: the generic phone controller for games another program hosts.
+ *
+ * The host is authoritative and the game is on the TV. The phone does three
+ * things, and the shell does the fourth (it streams the calibrated sensor
+ * frames at the game's `sendHz` while this screen is up):
+ *  - shows the host's latest `pad:prompt` for this player, big;
+ *  - offers one or two big buttons, which send `pad:press` / `pad:release`
+ *    with `{ button }` on finger down / up, with a buzz on every press;
+ *  - animates how to move the phone for the prompt's `mode`.
+ *
+ * Portrait first: the prompt sits on top and the buttons fill the bottom,
+ * where a thumb reaches. Landscape puts them side by side. Every target is at
+ * least 96 px tall.
+ */
+
+const MODE_LABEL = {
+  tilt: 'Tilt your phone',
+  swing: 'Swing your phone',
+  aim: 'Point your phone',
+  flick: 'Flick your phone',
+} as const satisfies Record<MotionPadMode, string>;
+
+/** Before the host's first prompt: the game's own words, from the protocol list. */
+function defaultPrompt(gameId: string | null, playerId: string): MotionPadPrompt {
+  const game = findMotionPadGame(gameId);
+  return {
+    playerId,
+    title: game?.controls.verb ?? 'Get ready',
+    subtitle: game?.controls.hint ?? 'Watch the TV.',
+    a: game?.buttons.a ?? '',
+    b: game?.buttons.b ?? '',
+    accent: game?.accent ?? null,
+    mode: game?.mode ?? null,
+  };
+}
+
+export function MotionPadController({ client, room, me, isActive, sample }: ControllerSurfaceProps) {
+  const game = findMotionPadGame(room.gameId);
+  const hostPrompt = useSyncExternalStore(
+    useCallback((listener: () => void) => subscribePadPrompts(client, listener), [client]),
+    () => currentPadPrompt(client, me.id),
+    () => null,
+  );
+  const prompt = hostPrompt ?? defaultPrompt(room.gameId, me.id);
+  const mode: MotionPadMode = prompt.mode ?? game?.mode ?? 'tilt';
+  const accent = prompt.accent ?? game?.accent ?? '#6d8bff';
+
+  // The readout is raw; the dot leans from the captured neutral, as Kart's wheel does.
+  const neutralBeta = useSyncExternalStore(
+    (listener) => client.store.subscribe(listener),
+    () => client.store.getState().calibration?.beta ?? 0,
+    () => 0,
+  );
+  const neutralGamma = useSyncExternalStore(
+    (listener) => client.store.subscribe(listener),
+    () => client.store.getState().calibration?.gamma ?? 0,
+    () => 0,
+  );
+  const neutral = { beta: neutralBeta, gamma: neutralGamma };
+
+  const [down, setDown] = useState<Record<MotionPadButton, boolean>>({ a: false, b: false });
+  const downRef = useRef<Record<MotionPadButton, boolean>>({ a: false, b: false });
+
+  const setButton = useCallback(
+    (button: MotionPadButton, next: boolean) => {
+      if (downRef.current[button] === next) return;
+      // A press while the pad is not live is dropped; a release always goes,
+      // so the host never holds a button the player has let go of.
+      if (next && !isActive) return;
+      downRef.current = { ...downRef.current, [button]: next };
+      setDown(downRef.current);
+      client.sendGameEvent(next ? PAD_PRESS_EVENT : PAD_RELEASE_EVENT, { button });
+      if (next) buzz(HAPTIC.press);
+    },
+    [client, isActive],
+  );
+
+  const releaseAll = useCallback(() => {
+    setButton('a', false);
+    setButton('b', false);
+  }, [setButton]);
+
+  // A button that vanishes from the prompt, the page hiding, or the pad
+  // unmounting all let go: the browser may never send the pointerup.
+  useEffect(() => {
+    if (!isActive) releaseAll();
+  }, [isActive, releaseAll]);
+  useEffect(() => {
+    if (!prompt.a) setButton('a', false);
+    if (!prompt.b) setButton('b', false);
+  }, [prompt.a, prompt.b, setButton]);
+  useEffect(() => {
+    const onHide = () => releaseAll();
+    document.addEventListener('visibilitychange', onHide);
+    window.addEventListener('pagehide', onHide);
+    return () => {
+      document.removeEventListener('visibilitychange', onHide);
+      window.removeEventListener('pagehide', onHide);
+      releaseAll();
+    };
+  }, [releaseAll]);
+
+  // A new prompt is news: a short buzz so a player watching the TV feels it.
+  const lastPromptKey = useRef<string | null>(null);
+  useEffect(() => {
+    if (!hostPrompt) return;
+    const key = `${hostPrompt.title}|${hostPrompt.subtitle}|${hostPrompt.a}|${hostPrompt.b}|${hostPrompt.mode}`;
+    if (lastPromptKey.current !== null && lastPromptKey.current !== key) buzz(HAPTIC.gesture);
+    lastPromptKey.current = key;
+  }, [hostPrompt]);
+
+  const buttons = (['a', 'b'] as const).filter((button) => prompt[button].length > 0);
+  const motionMissing = sample !== null && sample.gyro === null;
+  // The live dot only moves for the modes that are about attitude.
+  const lean = mode === 'tilt' || mode === 'aim' ? leanFrom(sample, neutral) : null;
+
+  return (
+    <Screen center={false} className="mc-game-controller mc-game-controller--pad select-none touch-none">
+      <div
+        className="motion-pad"
+        data-testid="motion-pad"
+        data-mode={mode}
+        data-game={room.gameId ?? ''}
+        style={cssVarStyle({ '--pad-accent': accent })}
+      >
+        <div className="motion-pad-prompt" role="status" aria-live="polite" aria-atomic="true">
+          <h1 className="motion-pad-title" data-testid="motion-pad-title">{prompt.title}</h1>
+          {prompt.subtitle ? (
+            <p className="motion-pad-subtitle" data-testid="motion-pad-subtitle">{prompt.subtitle}</p>
+          ) : null}
+        </div>
+
+        <div className="motion-pad-hint" aria-hidden>
+          <div className="motion-pad-hint-stage" data-testid="motion-pad-hint" data-mode={mode}>
+            <span className="motion-pad-phone" />
+            {lean ? (
+              <span
+                className="motion-pad-dot"
+                data-testid="motion-pad-dot"
+                style={{ transform: `translate(${Math.round(lean.x * 44)}px, ${Math.round(lean.y * 44)}px)` }}
+              />
+            ) : null}
+          </div>
+          <p className="motion-pad-hint-label">{MODE_LABEL[mode]}</p>
+        </div>
+
+        {motionMissing ? (
+          <p className="motion-pad-warning" data-testid="motion-pad-no-gyro">
+            This phone has no gyroscope, so movement is read from tilt only. Move a little bigger.
+          </p>
+        ) : null}
+
+        {buttons.length > 0 ? (
+          <div className="motion-pad-buttons" data-count={buttons.length}>
+            {buttons.map((button) => (
+              <button
+                key={button}
+                type="button"
+                data-testid={`motion-pad-${button}`}
+                data-down={down[button] ? 'true' : 'false'}
+                aria-pressed={down[button]}
+                aria-label={prompt[button]}
+                disabled={!isActive}
+                className={['motion-pad-button mc-pressable', `motion-pad-button--${button}`, down[button] ? 'is-down' : ''].join(' ')}
+                onPointerDown={(event) => {
+                  event.preventDefault();
+                  // jsdom and some embedded browsers have no pointer capture.
+                  event.currentTarget.setPointerCapture?.(event.pointerId);
+                  setButton(button, true);
+                }}
+                onPointerUp={() => setButton(button, false)}
+                onPointerCancel={() => setButton(button, false)}
+                onLostPointerCapture={() => setButton(button, false)}
+                onContextMenu={(event) => event.preventDefault()}
+                onKeyDown={(event) => {
+                  if (event.repeat || (event.key !== ' ' && event.key !== 'Enter')) return;
+                  event.preventDefault();
+                  setButton(button, true);
+                }}
+                onKeyUp={(event) => {
+                  if (event.key === ' ' || event.key === 'Enter') setButton(button, false);
+                }}
+                onBlur={() => setButton(button, false)}
+              >
+                {prompt[button]}
+              </button>
+            ))}
+          </div>
+        ) : (
+          <p className="motion-pad-nobuttons">No buttons. It is all in the motion.</p>
+        )}
+      </div>
+    </Screen>
+  );
+}
+
+/**
+ * -1..1 on each axis away from the neutral pose: gamma (roll) left/right,
+ * beta (pitch) toward/away. 45 degrees from neutral is the edge of the ring.
+ */
+export function leanFrom(
+  sample: ControllerSurfaceProps['sample'],
+  neutral: { beta: number; gamma: number } = { beta: 0, gamma: 0 },
+): { x: number; y: number } | null {
+  if (!sample) return null;
+  const axis = (value: number, zero: number) => {
+    if (!Number.isFinite(value)) return 0;
+    let delta = (value - (Number.isFinite(zero) ? zero : 0)) % 360;
+    if (delta > 180) delta -= 360;
+    if (delta <= -180) delta += 360;
+    return Math.max(-1, Math.min(1, delta / 45));
+  };
+  return { x: axis(sample.gamma, neutral.gamma), y: axis(sample.beta, neutral.beta) };
+}
