--- /dev/null
+++ b/app/src/games/pad/padPrompts.ts
@@ -0,0 +1,75 @@
+import { PAD_PROMPT_EVENT, readMotionPadPrompt, type MotionPadPrompt } from '@v2/protocol';
+import type { SessionClient } from '@v2/client-core';
+
+/**
+ * The latest `pad:prompt` per player, remembered per session client.
+ *
+ * The pad screen only exists while the server says the phone is `active`, but
+ * the host's prompt can land a moment before that flip (a turn-based game
+ * names the batter and prompts them in the same breath), and the screen
+ * remounts between turns and matches. So prompts are collected from the
+ * moment the shell knows this is a motion pad room, and the pad reads the
+ * latest one when it mounts. A prompt belongs to the match it arrived in.
+ *
+ * `playerId: "*"` addresses every phone; a player's own prompt wins over it.
+ */
+interface Remembered {
+  prompt: MotionPadPrompt;
+  matchNumber: number | null;
+  /** Arrival order, so the newer of "mine" and "everyone's" wins. */
+  order: number;
+}
+
+interface Watch {
+  prompts: Map<string, Remembered>;
+  listeners: Set<() => void>;
+  stop: () => void;
+}
+
+export const PAD_PROMPT_EVERYONE = '*';
+
+const watches = new WeakMap<SessionClient, Watch>();
+let arrivals = 0;
+
+function matchNumberOf(client: SessionClient): number | null {
+  return client.store.getState().room?.game.matchNumber ?? null;
+}
+
+/** Start remembering prompts for this client. Idempotent; the watch lives as long as the client. */
+export function watchPadPrompts(client: SessionClient): void {
+  if (watches.has(client)) return;
+  const watch: Watch = { prompts: new Map(), listeners: new Set(), stop: () => {} };
+  watch.stop = client.onGameEvent((event, data, fromPlayerId) => {
+    // Host frames carry no fromPlayerId; the server also refuses this event from phones.
+    if (event !== PAD_PROMPT_EVENT || fromPlayerId) return;
+    const prompt = readMotionPadPrompt(data);
+    if (!prompt) return;
+    arrivals += 1;
+    watch.prompts.set(prompt.playerId, { prompt, matchNumber: matchNumberOf(client), order: arrivals });
+    for (const listener of watch.listeners) listener();
+  });
+  watches.set(client, watch);
+}
+
+/** The prompt this player should see now, or null when the host has not prompted them this match. */
+export function currentPadPrompt(client: SessionClient, playerId: string): MotionPadPrompt | null {
+  const watch = watches.get(client);
+  if (!watch) return null;
+  const match = matchNumberOf(client);
+  const fresh = (entry: Remembered | undefined) =>
+    entry && (entry.matchNumber === null || match === null || entry.matchNumber === match) ? entry : null;
+  const mine = fresh(watch.prompts.get(playerId));
+  const everyone = fresh(watch.prompts.get(PAD_PROMPT_EVERYONE));
+  if (mine && everyone) return (mine.order > everyone.order ? mine : everyone).prompt;
+  return (mine ?? everyone)?.prompt ?? null;
+}
+
+/** Called after every remembered prompt. Returns an unsubscribe. */
+export function subscribePadPrompts(client: SessionClient, listener: () => void): () => void {
+  watchPadPrompts(client);
+  const watch = watches.get(client);
+  watch?.listeners.add(listener);
+  return () => {
+    watch?.listeners.delete(listener);
+  };
+}
